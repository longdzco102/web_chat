# ============================================
# Environment Variables Configuration
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# ============================================
# Application
# ============================================
NODE_ENV=production
PORT=3000

# ============================================
# Database (MySQL)
# ============================================
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=webchat
MYSQL_USER=webchat
MYSQL_PASSWORD=change-this-password-in-production

# Root password (for migrations/setup)
MYSQL_ROOT_PASSWORD=change-this-root-password-in-production

# ============================================
# JWT Authentication
# ============================================
JWT_SECRET=generate-a-long-random-string-here
JWT_EXPIRES_IN=7d

# ============================================
# AWS Configuration (for Terraform)
# ============================================
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key

# ============================================
# Terraform Variables
# ============================================
TF_VAR_db_password=database-password-for-terraform
TF_VAR_key_pair_name=your-ec2-key-pair-name
