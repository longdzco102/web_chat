# TiDB Cloud → Connect → "Connect with" Node.js → copy từng field
TIDB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
TIDB_PORT=4000
TIDB_USER=<tên user thật>
TIDB_PASS=<password thật>
TIDB_NAME=xianxia_chat
TIDB_SSL=true

# Cloudinary → console.cloudinary.com → Dashboard
CLOUDINARY_CLOUD_NAME=<cloud name>
CLOUDINARY_API_KEY=<api key>
CLOUDINARY_API_SECRET=<api secret>