{
  "name": "xianxia-chat-backend",
  "version": "1.0.0",
  "description": "Backend API + Socket.io – TiDB + Cloudinary",
  "main": "src/app.js",
  "scripts": {
    "dev":   "nodemon src/app.js",
    "start": "node src/app.js",
    "db:init": "node src/scripts/initDb.js"
  },
  "dependencies": {
    "bcryptjs":    "^2.4.3",
    "cloudinary":  "^2.2.0",
    "cors":        "^2.8.5",
    "dotenv":      "^16.3.1",
    "express":     "^4.18.2",
    "jsonwebtoken":"^9.0.2",
    "multer":      "^1.4.5-lts.1",
    "mysql2":      "^3.6.1",
    "socket.io":   "^4.7.2",
    "uuid":        "^11.0.5"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  },
  "nodemonConfig": {
    "watch": ["src"],
    "ext": "js,json",
    "ignore": ["node_modules"]
  }
}
