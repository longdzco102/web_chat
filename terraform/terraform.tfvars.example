# ============================================
# Terraform Variables - Production
# ============================================
# Copy this file to terraform.tfvars and fill in values
# NEVER commit terraform.tfvars to version control!
# ============================================

# AWS Region
aws_region = "ap-southeast-1"

# Project naming
project_name = "xianxia-chat"
environment  = "production"

# EC2 Configuration
instance_type    = "t3.small"
key_pair_name    = "your-key-pair-name"  # Create in AWS Console: EC2 > Key Pairs

# Your IP for SSH access (find your IP: curl ifconfig.me)
my_ip = "YOUR_IP_HERE/32"

# Database Configuration
db_password      = "your-secure-database-password"
db_instance_class = "db.t3.micro"
db_allocated_storage = 20

# Application
app_port = 80

# Enable NAT Gateway for private subnets
enable_nat_gateway = true
